@model List<Asp_net.Models.ProductViewModel>

@{
    ViewData["Title"] = "All Products";
}

<h2>Products</h2>

<ul>
    @foreach (var product in Model)
    {
        <li>
            <a asp-controller="Products" asp-action="ById" asp-route-id="@product.Id">
                @product.Name - @product.Price lv
            </a>
        </li>
    }
</ul>